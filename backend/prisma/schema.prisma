generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CarStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum UserRole {
  ADMIN
}

model Model {
  id        Int      @id @default(autoincrement())
  brand     String
  modelName String
  bodyType  String
  cars      Car[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brand, modelName])
}

model Car {
  id           Int        @id @default(autoincrement())
  modelId      Int
  year         Int
  price        Decimal    @db.Decimal(12, 2)
  mileage      Int
  engine       String
  transmission String
  fuelType     String
  color        String
  description  String
  imageUrl     String
  status       CarStatus  @default(AVAILABLE)
  model        Model      @relation(fields: [modelId], references: [id], onDelete: Restrict)
  applications Application[]
  testDrives   TestDrive[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Client {
  id           Int           @id @default(autoincrement())
  fullName     String
  phone        String
  email        String
  applications Application[]
  testDrives   TestDrive[]
  createdAt    DateTime      @default(now())

  @@unique([phone, email])
}

model Application {
  id        Int      @id @default(autoincrement())
  clientId  Int
  carId     Int
  message   String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model TestDrive {
  id            Int      @id @default(autoincrement())
  clientId      Int
  carId         Int
  preferredDate DateTime
  comment       String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  car           Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}

model User {
  id           Int      @id @default(autoincrement())
  login        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
}
